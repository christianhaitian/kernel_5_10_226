/dts-v1/;

#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/input/rk-input.h>
#include <dt-bindings/sensor-dev.h>
#include <dt-bindings/display/drm_mipi_dsi.h>
#include "rk3566.dtsi"
#include "rk3568-linux.dtsi"

/ {
	model = "MINILOONG Pocket1 aka me loove it loong time";
	compatible = "miniloong,pocket1", "rockchip,rk3566";

	chosen: chosen {
		stdout-path = "serial2:1500000n8";
	};

	adc_keys: adc-keys {
		status = "disabled";
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		vol-up-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <1750>;
		};

		vol-down-key {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <297500>;
		};
	};

	rk_headset: rk-headset {
		compatible = "rockchip_headset";
		headset_gpio = <&gpio4 RK_PC6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det>;
		io-channels = <&saradc 2>;
	};

	backlight: backlight {
		status = "okay";
		compatible = "pwm-backlight";
		pwms = <&pwm3 0 25000 0>;
		enable-gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
		brightness-levels = <
			0 260 260 260 260 260 260 260 260 260 260 260 260 260 261 261
			261 261 261 261 261 261 262 262 262 262 262 262 263 263 263 263
			264 264 264 264 265 265 265 266 266 266 267 267 267 268 268 268
			269 269 270 270 271 271 271 272 272 273 273 274 274 275 275 276
			277 277 278 278 279 280 280 281 281 282 283 284 284 285 286 286
			287 288 289 289 290 291 292 293 293 294 295 296 297 298 299 300
			300 301 302 303 304 305 306 307 308 309 310 311 312 314 315 316
			317 318 319 320 321 323 324 325 326 327 329 330 331 332 334 335
			336 338 339 340 342 343 344 346 347 348 350 351 353 354 356 357
			359 360 362 363 365 366 368 370 371 373 374 376 378 379 381 383
			384 386 388 390 391 393 395 397 399 400 402 404 406 408 410 412
			414 415 417 419 421 423 425 427 429 431 433 435 437 440 442 444
			446 448 450 452 455 457 459 461 463 466 468 470 472 475 477 479
			482 484 486 489 491 494 496 498 501 503 506 508 511 513 516 518
			521 524 526 529 531 534 537 539 542 545 547 550 572 595 618 640
			662 685 708 730 752 775 798 820 842 865 888 910 932 955 978 1000
		>;
		default-brightness-level = <120>;
	};

	charge-animation {
		compatible = "rockchip,uboot-charge";
		rockchip,uboot-charge-on = <1>;
		rockchip,android-charge-on = <0>;
		rockchip,uboot-low-power-voltage = <3350>;
		rockchip,screen-on-voltage = <3400>;
		status = "okay";
	};

	flash_rgb13h: flash-rgb13h {
		status = "disabled";
		compatible = "led,rgb13h";
		label = "gpio-flash";
		pinctrl-names = "default";
		pinctrl-0 = <&flash_led_gpios>;
		led-max-microamp = <20000>;
		flash-max-microamp = <20000>;
		flash-max-timeout-us = <1000000>;
		enable-gpio = <&gpio4 6 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
	};

	rk817_sound: rk817-sound {
		/*
		 * Match the known-working dArkOS/RGB20Pro RK817 card binding.
		 * Keep this simple until the codec card appears in aplay -l.
		 */
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "rockchip,rk817-codec";
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,cpu {
			sound-dai = <&i2s1_8ch>;
		};

		simple-audio-card,codec {
			sound-dai = <&rk817_codec>;
		};
	};

	hdmi_sound: hdmi-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <128>;
		simple-audio-card,name = "rockchip,hdmi";
		status = "okay";

		simple-audio-card,cpu {
				sound-dai = <&i2s0_8ch>;
		};
		simple-audio-card,codec {
				sound-dai = <&hdmi>;
		};
	};

	vccsys: vccsys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v8_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3800000>;
		regulator-max-microvolt = <3800000>;
	};

	vcc_camera: vcc-camera-regulator {
		compatible = "regulator-fixed";
		gpio = <&gpio4 RK_PB1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&camera_rst>;
		regulator-name = "vcc_camera";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk817 1>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;

		/*
		 * On the module itself this is one of these (depending
		 * on the actual card populated):
		 * - SDIO_RESET_L_WL_REG_ON
		 * - PDN (power down when low)
		 */
		post-power-on-delay-ms = <200>;
		reset-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
	};

	vcc_sd: vcc-sd {
		compatible = "regulator-gpio";
		enable-active-low;
		enable-gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc_sd_h>;
		regulator-name = "vcc_sd";
		states = <3300000 0x0
			3300000 0x1>;
	};

	vcc_wifi_io: vcc-wifi-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc_wifi_io";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		wifi_chip_type = "ap6255";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_irq>;
		WIFI,host_wake_irq = <&gpio2 RK_PB2 GPIO_ACTIVE_HIGH>;
		//WIFI,poweren_gpio = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	wireless-bluetooth {
		status = "disabled";
	};

	/*
	 * Digital controls use gpio-keys because Miniloong buttons are plain GPIOs.
	 * This preserves the working Miniloong button input path while mimicking
	 * the dArkOS retrogame_joypad identity as far as gpio-keys allows via DTS.
	 *
	 * If your gpio-keys driver does not copy linux,input-vendor/product/version
	 * into input_dev->id, SDL GUID will still differ and a tiny gpio_keys.c
	 * patch is required.
	 */
	gpio_keys_vol: gpio-keys-vol {
		/*
		 * Keep volume keys separate from retrogame_joypad so the
		 * joypad SDL mapping/bitmap stays RGB20Pro-compatible.
		 */
		compatible = "gpio-keys";
		autorepeat;
		status = "okay";

		button-volup {
			gpios = <&gpio4 RK_PA5 GPIO_ACTIVE_LOW>;
			label = "VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <10>;
		};

		button-voldown {
			gpios = <&gpio4 RK_PA4 GPIO_ACTIVE_LOW>;
			label = "VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			debounce-interval = <10>;
		};
	};
	
	joypad: singleadc-joypad {
		/*
		 * Requires patched singleadcjoy.c with Miniloong direct-adc mode.
		 *
		 * This uses the real dArkOS singleadc-joypad input path so the
		 * Miniloong reports like RGB20Pro:
		 *   Name    = retrogame_joypad
		 *   Bus     = 0019
		 *   Vendor  = 484b
		 *   Product = 1101
		 *   Version = 0100
		 *   Phys    = retrogame_joypad/input0
		 *
		 * It also exposes ABS/FF capabilities instead of a keyboard-like
		 * gpio-keys device.
		 */
		compatible = "miniloong,singleadc-joypad", "singleadc-joypad";
		status = "okay";

		/* rumble */
		/* pwms = <&pwm5 0 10000 0>; */
		pwms = <&pwm2 0 10000 0>;

		joypad-name = "retrogame_joypad";
		joypad-product = <0x1101>;
		joypad-revision = <0x0100>;

		/*
		 * Miniloong direct SARADC layout:
		 *   SARADC3 = X
		 *   SARADC2 = Y
		 */
		direct-adc;
		io-channel-names = "joy_x", "joy_y";
		io-channels = <&saradc 3>, <&saradc 2>;

		/*
		 * Keep amux-count at 4 so the input capability bitmap includes
		 * ABS_X, ABS_Y, ABS_RX, and ABS_RY like the RGB20Pro. The
		 * patched driver centers RX/RY because Miniloong has one stick.
		 */
		amux-count = <4>;
		button-adc-scale = <2>;
		button-adc-deadzone = <48>;
		button-adc-fuzz = <16>;
		button-adc-flat = <16>;
		poll-interval = <10>;
		direct-adc-gain = <6>;

		abs_x-p-tuning = <250>;
		abs_x-n-tuning = <250>;
		abs_y-p-tuning = <250>;
		abs_y-n-tuning = <250>;
		abs_rx-p-tuning = <250>;
		abs_rx-n-tuning = <250>;
		abs_ry-p-tuning = <250>;
		abs_ry-n-tuning = <250>;

		pinctrl-names = "default";
		pinctrl-0 = <&gpio_keys_ctrl>;

		sw1 {
			gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_LOW>;
			label = "BTN_UP";
			linux,code = <BTN_DPAD_UP>;
		};

		sw2 {
			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_LOW>;
			label = "BTN_DOWN";
			linux,code = <BTN_DPAD_DOWN>;
		};

		sw3 {
			gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
			label = "BTN_LEFT";
			linux,code = <BTN_DPAD_LEFT>;
		};

		sw4 {
			gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
			label = "BTN_RIGHT";
			linux,code = <BTN_DPAD_RIGHT>;
		};

		sw5 {
			gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_LOW>;
			label = "BTNSOUTH";
			linux,code = <BTN_SOUTH>;
		};

		sw6 {
			gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
			label = "BTNEAST";
			linux,code = <BTN_EAST>;
		};

		sw7 {
			gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;
			label = "BTNWEST";
			linux,code = <BTN_WEST>;
		};

		sw8 {
			gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_LOW>;
			label = "BTNNORTH";
			linux,code = <BTN_NORTH>;
		};

		sw9 {
			gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_LOW>;
			label = "SELECT";
			linux,code = <BTN_SELECT>;
		};

		sw10 {
			gpios = <&gpio4 RK_PA3 GPIO_ACTIVE_LOW>;
			label = "START";
			linux,code = <BTN_START>;
		};

		sw11 {
			gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_LOW>;
			label = "MODE";
			linux,code = <BTN_MODE>;
		};

		sw12 {
			gpios = <&gpio3 RK_PD6 GPIO_ACTIVE_LOW>;
			label = "BTN_L1";
			linux,code = <BTN_TL>;
		};

		sw13 {
			gpios = <&gpio4 RK_PA0 GPIO_ACTIVE_LOW>;
			label = "BTN_R1";
			linux,code = <BTN_TR>;
		};

		sw14 {
			gpios = <&gpio3 RK_PD7 GPIO_ACTIVE_LOW>;
			label = "BTN_L2";
			linux,code = <BTN_TL2>;
		};

		sw15 {
			gpios = <&gpio4 RK_PA1 GPIO_ACTIVE_LOW>;
			label = "BTN_R2";
			linux,code = <BTN_TR2>;
		};

		sw16 {
			gpios = <&gpio2 RK_PC5 GPIO_ACTIVE_LOW>;
			label = "LEFT JOYSTICK MIDDLE";
			linux,code = <BTN_THUMBL>;
		};
	};

	/*
	 * Placeholder for Miniloong analog stick hardware.
	 * This is disabled because the existing dArkOS singleadc-joypad
	 * binding expects an ADC mux, while Miniloong uses direct ADC channels.
	 */

	mangmi_powerCtrl: mangmi-powerctrl {
		compatible = "mangmi,powerCtrl";
		pinctrl-names = "default";
		pinctrl-0 = <&powerCtrl_en>;
		typec-5v-en-gpio = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
		spk-ctl-gpio = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};
};

&bus_npu {
	bus-supply = <&vdd_logic>;
	pvtm-supply = <&vdd_cpu>;
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
};

&csi2_dphy_hw {
	status = "okay";
};

&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_in_ucam0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gc2385_out>;
				data-lanes = <1>;
			};
			mipi_in_ucam1: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&ov8858_out>;
				data-lanes = <1 2 3 4>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&isp0_in>;
			};
		};
	};
};

&dfi {
	status = "okay";
};

&dmc {
	operating-points-v2 = <&dmc_opp_table>;
	center-supply = <&vdd_logic>;
	status = "okay";

	/*
	 * Copied verbatim from the stock/vendor dts's &dmc node -- absent
	 * from this file previously. These tell the rockchip DMC (DDR
	 * frequency) devfreq governor to proactively bump DDR clock speed
	 * in response to VOP display bandwidth demand, rather than relying
	 * only on generic reactive CPU-load-based scaling. Without these,
	 * DDR could stay at a lower frequency during a sudden display
	 * bandwidth spike (more likely at 90/120Hz, where there's less
	 * time per frame for the memory subsystem to keep up), letting the
	 * VOP's line buffer run dry for a frame -- producing exactly the
	 * kind of brief white flash seen during active use. All values are
	 * plain numeric bandwidth-threshold/frequency pairs, not phandles,
	 * so a direct copy from stock is safe.
	 */
	vop-bw-dmc-freq = <0x00 0x11e 0x4f1a0 0x11f 0x1869f 0x80e80>;
	vop-frame-bw-dmc-freq = <0x00 0x26c 0x4f1a0 0x26d 0x1869f 0xbe6e0>;
	cpu-bw-dmc-freq = <0x00 0x15e 0x4f1a0 0x15f 0x190 0x80e80 0x191 0x1869f 0xbe6e0>;
	system-status-level = <0x01 0x04 0x08 0x08 0x02 0x01 0x10 0x04 0x10000 0x04 0x1000 0x08 0x4000 0x08 0x2000 0x08 0xc00 0x08>;
	auto-min-freq = <0x4f1a0>;
	auto-freq-en = <0x01>;
	upthreshold = <0x28>;
	downdifferential = <0x14>;
	#cooling-cells = <2>;
};

&dsi0 {
	status = "okay";
	/*
	 * Deliberately NOT setting rockchip,lane-rate here (stock/vendor
	 * dts never sets it either -- confirmed by direct comparison).
	 * Leaving it unset lets the dw-mipi-dsi driver auto-calculate the
	 * DSI PHY bit rate per active mode, rather than forcing a fixed
	 * 1000 Mbps/lane regardless of refresh rate. A fixed high rate
	 * means the burst duty cycle (fraction of each line spent
	 * actively toggling at high speed) grows with refresh rate even
	 * though peak PHY bit rate doesn't -- a plausible source of
	 * refresh-rate-dependent signal margin issues on some panel/cable
	 * batches. If 90/120Hz white-screens on a given unit even with
	 * this removed, that rules this out and points back toward a
	 * genuine per-unit hardware margin limit instead.
	 */
	dsi0_panel: panel@0 {
		compatible = "miniloong,pocket1-panel", "simple-panel-dsi";
		reg = <0>;
		backlight = <&backlight>;
		enable-gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_enable_gpio>, <&lcd_rst_gpio>;
		prepare-delay-ms = <120>;
		reset-delay-ms = <120>;
		init-delay-ms = <120>;
		stbyb-delay-ms = <120>;
		enable-delay-ms = <120>;
		disable-delay-ms = <120>;
		unprepare-delay-ms = <120>;
		width-mm = <229>;
		height-mm = <143>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_EOT_PACKET)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes = <4>;
		panel-init-sequence = [
			39 00 04 ff 98 81 03 15 00 02 01 00 15 00 02 02
			00 15 00 02 03 72 15 00 02 04 00 15 00 02 05 00
			15 00 02 06 09 15 00 02 07 00 15 00 02 08 00 15
			00 02 09 01 15 00 02 0a 00 15 00 02 0b 00 15 00
			02 0c 01 15 00 02 0d 00 15 00 02 0e 00 15 00 02
			0f 00 15 00 02 10 00 15 00 02 11 00 15 00 02 12
			00 15 00 02 13 00 15 00 02 14 00 15 00 02 15 00
			15 00 02 16 00 15 00 02 17 00 15 00 02 18 00 15
			00 02 19 00 15 00 02 1a 00 15 00 02 1b 00 15 00
			02 1c 00 15 00 02 1d 00 15 00 02 1e 40 15 00 02
			1f 80 15 00 02 20 05 15 00 02 21 02 15 00 02 22
			00 15 00 02 23 00 15 00 02 24 00 15 00 02 25 00
			15 00 02 26 00 15 00 02 27 00 15 00 02 28 33 15
			00 02 29 02 15 00 02 2a 00 15 00 02 2b 00 15 00
			02 2c 00 15 00 02 2d 00 15 00 02 2e 00 15 00 02
			2f 00 15 00 02 31 00 15 00 02 32 00 15 00 02 33
			00 15 00 02 34 04 15 00 02 35 00 15 00 02 36 00
			15 00 02 37 00 15 00 02 38 3c 15 00 02 39 00 15
			00 02 3a 40 15 00 02 3b 40 15 00 02 3c 00 15 00
			02 3d 00 15 00 02 3e 00 15 00 02 3f 00 15 00 02
			40 00 15 00 02 41 00 15 00 02 42 00 15 00 02 43
			00 15 00 02 44 00 15 00 02 50 01 15 00 02 51 23
			15 00 02 52 45 15 00 02 53 67 15 00 02 54 89 15
			00 02 55 ab 15 00 02 56 01 15 00 02 57 23 15 00
			02 58 45 15 00 02 59 67 15 00 02 5a 89 15 00 02
			5b ab 15 00 02 5c cd 15 00 02 5d ef 15 00 02 5e
			11 15 00 02 5f 01 15 00 02 60 00 15 00 02 61 15
			15 00 02 62 14 15 00 02 63 0e 15 00 02 64 0f 15
			00 02 65 0c 15 00 02 66 0d 15 00 02 67 06 15 00
			02 68 02 15 00 02 69 07 15 00 02 6a 02 15 00 02
			6b 02 15 00 02 6c 02 15 00 02 6d 02 15 00 02 6e
			02 15 00 02 6f 02 15 00 02 70 02 15 00 02 71 02
			15 00 02 72 02 15 00 02 73 02 15 00 02 74 02 15
			00 02 75 01 15 00 02 76 00 15 00 02 77 14 15 00
			02 78 15 15 00 02 79 0e 15 00 02 7a 0f 15 00 02
			7b 0c 15 00 02 7c 0d 15 00 02 7d
			06 15 00 02 7e
			02 15 00 02 7f 07 15 00 02 80 02 15 00 02 81 02
			15 00 02 82 02 15 00 02 83 02 15 00 02 84 02 15
			00 02 85 02 15 00 02 86 02 15 00 02 87 02 15 00
			02 88 02 15 00 02 89 02 15 00 02 8a 02 39 00 04
			ff 98 81 04 15 00 02 38 01 15 00 02 39 00 15 00
			02 6c 15 15 00 02 6e 2a 15 00 02 6f 34 15 00 02
			3a 94 15 00 02 8d 14 15 00 02 87 ba 15 00 02 26
			76 15 00 02 b2 d1 15 00 02 b5 06 15 00 02 3b 98
			39 00 04 ff 98 81 01 15 00 02 22 09 15 00 02 2e
			78 15 00 02 31 00 15 00 02 53 90 15 00 02 55 a2
			15 00 02 50 b7 15 00 02 51 b7 15 00 02 60 22 15
			00 02 61 00 15 00 02 62 19 15 00 02 63 10 15 00
			02 a0 08 15 00 02 a1 1a 15 00 02 a2 27 15 00 02
			a3 15 15 00 02 a4 17 15 00 02 a5 2a 15 00 02 a6
			1e 15 00 02 a7 1f 15 00 02 a8 8b 15 00 02 a9 1b
			15 00 02 aa 27 15 00 02 ab 78 15 00 02 ac 18 15
			00 02 ad 18 15 00 02 ae 4c 15 00 02 af 21 15 00
			02 b0 27 15 00 02 b1 54 15 00 02 b2 67 15 00 02
			b3 39 15 00 02 c0 08 15 00 02 c1 1a 15 00 02 c2
			27 15 00 02 c3 15 15 00 02 c4 17 15 00 02 c5 2a
			15 00 02 c6 1e 15 00 02 c7 1f 15 00 02 c8 8b 15
			00 02 c9 1b 15 00 02 ca 27 15 00 02 cb 78 15 00
			02 cc 18 15 00 02 cd 18 15 00 02 ce 4c 15 00 02
			cf 21 15 00 02 d0 27 15 00 02 d1 54 15 00 02 d2
			67 15 00 02 d3 39 39 00 04 ff 98 81 00 15 00 02
			35 00 05 c8 01 11 05 28 01 29
		];
		panel-exit-sequence = [
			05 dc 01 28
			05 78 01 10
		];
		display-timings {
			/*
			 * Informational only: panel-miniloong-pocket1.c builds
			 * its own drm_display_mode table (60/90/120Hz) rather
			 * than reading this node via of_get_display_timing().
			 * Kept here in sync so the DTS documents what the
			 * driver actually exposes. native-mode stays on the
			 * 60Hz timing as the safe default (module parameter
			 * preferred_refresh_hz controls the actual boot
			 * default in the driver).
			 */
			native-mode = <&dsi0_timing0>;
			dsi0_timing0: timing0 {
				clock-frequency = <47000000>;
				hactive = <720>;
				vactive = <960>;
				hsync-len = <14>;
				hback-porch = <20>;
				hfront-porch = <15>;
				vsync-len = <8>;
				vback-porch = <20>;
				vfront-porch = <30>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
			dsi0_timing1: timing1 {
				clock-frequency = <70456000>;
				hactive = <720>;
				vactive = <960>;
				hsync-len = <14>;
				hback-porch = <20>;
				hfront-porch = <15>;
				vsync-len = <8>;
				vback-porch = <20>;
				vfront-porch = <30>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
			dsi0_timing2: timing2 {
				clock-frequency = <93941000>;
				hactive = <720>;
				vactive = <960>;
				hsync-len = <14>;
				hback-porch = <20>;
				hfront-porch = <15>;
				vsync-len = <8>;
				vback-porch = <20>;
				vfront-porch = <30>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 { reg = <0>; panel_in_dsi: endpoint { remote-endpoint = <&dsi_out_panel>; }; };
		};
	};
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@1 { reg = <1>; dsi_out_panel: endpoint { remote-endpoint = <&panel_in_dsi>; }; };
	};
};

&dsi0_in_vp0 {
	status = "okay";
};

&dsi0_in_vp1 {
	status = "disabled";
};

&gpu {
	mali-supply = <&vdd_gpu>;
	mem-supply = <&vdd_gpu>;
	status = "okay";
	operating-points-v2 = <&gpu_opp_table>;
};

&hdmi {
	status = "okay";
};

&hdmi_in_vp0 {
	status = "okay";
};

&hdmi_in_vp1 {
	status = "disabled";
};

&hdmi_sound {
	status = "okay";
};

&i2c0 {
	status = "okay";

	vdd_cpu: tcs4525@1c {
		compatible = "tcs,tcs4525";
		reg = <0x1c>;
		vin-supply = <&vccsys>;
		regulator-compatible = "fan53555-reg";
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <712500>;
		regulator-max-microvolt = <1390000>;
		regulator-init-microvolt = <900000>;
		regulator-ramp-delay = <2300>;
		fcs,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	rk817: pmic@20 {
		compatible = "rockchip,rk817";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default", "pmic-sleep",
				"pmic-power-off", "pmic-reset";
		pinctrl-0 = <&pmic_int>;
		pinctrl-1 = <&soc_slppin_slp>, <&rk817_slppin_slp>;
		pinctrl-2 = <&soc_slppin_gpio>, <&rk817_slppin_pwrdn>;
		pinctrl-3 = <&soc_slppin_gpio>, <&rk817_slppin_rst>;
		rockchip,system-power-controller;
		wakeup-source;
		#clock-cells = <1>;
		clock-output-names = "rk808-clkout1", "rk808-clkout2";
		//fb-inner-reg-idxs = <2>;
		/* 1: rst regs (default in codes), 0: rst the pmic */
		pmic-reset-func = <0>;
		/* not save the PMIC_POWER_EN register in uboot */
		not-save-power-en = <1>;

		vcc1-supply = <&vccsys>;
		vcc2-supply = <&vccsys>;
		vcc3-supply = <&vccsys>;
		vcc4-supply = <&vccsys>;
		vcc5-supply = <&vccsys>;
		vcc6-supply = <&vccsys>;
		vcc7-supply = <&vccsys>;
		vcc8-supply = <&vccsys>;
		vcc9-supply = <&dcdc_boost>;

		pwrkey {
			status = "okay";
		};

		pinctrl_rk8xx: pinctrl_rk8xx {
			gpio-controller;
			#gpio-cells = <2>;

			rk817_slppin_null: rk817_slppin_null {
				pins = "gpio_slp";
				function = "pin_fun0";
			};

			rk817_slppin_slp: rk817_slppin_slp {
				pins = "gpio_slp";
				function = "pin_fun1";
			};

			rk817_slppin_pwrdn: rk817_slppin_pwrdn {
				pins = "gpio_slp";
				function = "pin_fun2";
			};

			rk817_slppin_rst: rk817_slppin_rst {
				pins = "gpio_slp";
				function = "pin_fun3";
			};
		};

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-init-microvolt = <900000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <0x2>;
				regulator-name = "vdd_logic";
				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vdd_gpu: DCDC_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-init-microvolt = <900000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <0x2>;
				regulator-name = "vdd_gpu";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-name = "vcc_ddr";
				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_3v3: DCDC_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <0x2>;
				regulator-name = "vcc_3v3";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcca1v8_pmu: LDO_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcca1v8_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdda_0v9: LDO_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdda_0v9";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v9_pmu: LDO_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdda0v9_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vccio_acodec: LDO_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vccio_acodec";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vccio_sd";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc3v3_pmu: LDO_REG6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc3v3_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3000000>;
				};
			};

			vcc_1v8: LDO_REG7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc1v8_dvp: LDO_REG8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc1v8_dvp";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc2v8_dvp: LDO_REG9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-name = "vcc2v8_dvp";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			dcdc_boost: BOOST {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5000000>;
				regulator-name = "boost";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			otg_switch: OTG_SWITCH {
				regulator-name = "otg_switch";
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5000000>;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};

		battery {
			compatible = "rk817,battery";
			ocv_table = <3400 3513 3578 3687 3734 3752 3763
				     3766 3771 3784 3804 3836 3885 3925
				     3962 4005 4063 4114 4169 4227 4303>;
			design_capacity = <5000>;
			design_qmax = <5500>;
			bat_res = <100>;
			sleep_enter_current = <150>;
			sleep_exit_current = <180>;
			sleep_filter_current = <100>;
			power_off_thresd = <3350>;
			zero_algorithm_vol = <3850>;
			max_soc_offset = <60>;
			monitor_sec = <5>;
			sample_res = <10>;
			virtual_power = <0>;
		};

		charger {
			compatible = "rk817,charger";
			min_input_voltage = <4500>;
			max_input_current = <1500>;
			max_chrg_current = <2000>;
			max_chrg_voltage = <4250>;
			chrg_term_mode = <0>;
			chrg_finish_cur = <300>;
			virtual_power = <0>;
			dc_det_adc = <0>;
			extcon = <&usb2phy0>;
			rockchip,validate-charger-with-pmic-plugin;
		};

		rk817_codec: codec {
			#sound-dai-cells = <0>;
			compatible = "rockchip,rk817-codec";
			clocks = <&cru I2S1_MCLKOUT>;
			clock-names = "mclk";
			assigned-clocks = <&cru I2S1_MCLKOUT>, <&cru I2S1_MCLK_TX_IOE>;
			assigned-clock-rates = <12288000>;
			assigned-clock-parents = <&cru I2S1_MCLKOUT_TX>, <&cru I2S1_MCLKOUT_TX>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2s1m0_mclk>;
			hp-volume = <20>;
			spk-volume = <3>;
			out-l2spk-r2hp;
			/* Miniloong external speaker amp enable */
			//spk-ctl-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
			/* Miniloong headphone detect */
			//hp-det-gpios = <&gpio4 RK_PC6 GPIO_ACTIVE_HIGH>;
			status = "okay";
		};
	};
	/* es8316: es8316@10 {
		status = "disabled";
		#sound-dai-cells = <0>;
		compatible = "everest,es8316";
		reg = <0x10>;
		clocks = <&cru I2S1_MCLKOUT>;
		clock-names = "mclk";
		assigned-clocks = <&cru I2S1_MCLKOUT>, <&cru I2S1_MCLK_TX_IOE>;
		assigned-clock-rates = <11289600>;
		assigned-clock-parents = <&cru I2S1_MCLKOUT_TX>, <&cru I2S1_MCLKOUT_TX>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2s1m0_mclk>;
		hp-det-gpio = <&gpio4 RK_PC6 GPIO_ACTIVE_HIGH>;		
		//spk-con-gpio = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
	}; */
};

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2m1_xfer>;

	dw9714: dw9714@c {
		compatible = "dongwoon,dw9714";
		status = "okay";
		reg = <0x0c>;
		rockchip,camera-module-index = <0>;
		rockchip,vcm-start-current = <10>;
		rockchip,vcm-rated-current = <85>;
		rockchip,vcm-step-mode = <5>;
		rockchip,camera-module-facing = "back";
	};

	gc2385: gc2385@37 {
		compatible = "galaxycore,gc2385";
		status = "okay";
		reg = <0x37>;
		clocks = <&cru CLK_CIF_OUT>;
		clock-names = "xvclk";
		power-domains = <&power RK3568_PD_VI>;
		pinctrl-names = "rockchip,camera_default";
		pinctrl-0 = <&cif_clk>;

		//reset pin control by hardware,used this pin switch to mipi input
		//1->2LANE(LANE 0&1) FRONT camera, 0->4LANE REAR camera
		reset-gpios = <&gpio4 17 GPIO_ACTIVE_LOW>;
		pwdn-gpios = <&gpio4 10 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "HS5885-BNSM1018-V01";
		rockchip,camera-module-lens-name = "default";
		port {
			gc2385_out: endpoint {
				remote-endpoint = <&mipi_in_ucam0>;
				data-lanes = <1>;
			};
		};
	};

	ov8858: ov8858@36 {
		status = "okay";
		compatible = "ovti,ov8858";
		reg = <0x36>;
		clocks = <&cru CLK_CAM0_OUT>;
		clock-names = "xvclk";
		power-domains = <&power RK3568_PD_VI>;
		pinctrl-names = "rockchip,camera_default", "rockchip,camera_sleep";
		pinctrl-0 = <&cam_clkout0>;
		pinctrl-1 = <&cam_sleep>;
		//reset pin control by hardware,used this pin switch to mipi input
		//1->2LANE(LANE 0&1) FRONT camera, 0->4LANE REAR camera
		reset-gpios = <&gpio4 17 GPIO_ACTIVE_LOW>;
		pwdn-gpios = <&gpio4 11 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "HS5885-BNSM1018-V01";
		rockchip,camera-module-lens-name = "default";
		flash-leds = <&flash_rgb13h>;
		lens-focus = <&dw9714>;
		port {
			ov8858_out: endpoint {
				remote-endpoint = <&mipi_in_ucam1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m1_xfer>;
	clock-frequency = <400000>;
	i2c-scl-rising-time-ns = <138>;
	i2c-scl-falling-time-ns = <4>;

	ts@40 {
		compatible = "gslX680-pad";
		reg = <0x40>;
		touch-gpio = <&gpio3 RK_PB0 IRQ_TYPE_LEVEL_HIGH>;
		reset-gpio = <&gpio3 RK_PB1 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&tp_gpio>;
		screen_max_x = <1200>;
		screen_max_y = <1920>;
		revert_x = <0>;
		revert_y = <1>;
		revert_xy = <0>;
		chip_id = <1>;
		status = "okay";
	};
};

&i2c5 {
	status = "okay";
	clock-frequency = <400000>;
	i2c-scl-rising-time-ns = <144>;
	i2c-scl-falling-time-ns = <4>;

	sensor@18 {
		compatible = "gs_sc7a20";
		reg = <0x18>;
		type = <SENSOR_TYPE_ACCEL>;
		irq_enable = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&sensor_gpio>;
		irq-gpio = <&gpio3 RK_PA2 IRQ_TYPE_EDGE_RISING>;
		poll_delay_ms = <10>;
		layout = <1>;
	};
};

&i2s0_8ch {
	status = "okay";
};

&i2s1_8ch {
	status = "okay";
	rockchip,clk-trcm = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2s1m0_sclktx
		     &i2s1m0_lrcktx
		     &i2s1m0_sdi0
		     &i2s1m0_sdo0>;
};

&iep {
	status = "okay";
};

&iep_mmu {
	status = "okay";
};

&jpegd {
	status = "okay";
};

&jpegd_mmu {
	status = "okay";
};

&video_phy0 {
	status = "okay";
};

&mpp_srv {
	status = "okay";
};

&nandc0 {
	status = "okay";
};

&i2c1 {
	status = "okay";

	aw20036: aw20036_led@3a {
		compatible = "awinic,aw20036_led";
		reg = <0x3a>;
		status = "okay";

		reset-gpio = <&gpio4 RK_PC3 GPIO_ACTIVE_HIGH>;
		irq-gpio = <&gpio4 RK_PC2 GPIO_ACTIVE_HIGH>;

		pinctrl-names = "default";
		pinctrl-0 = <&aw20036_pins>;

		aw20036,led {
			aw20036,name = "aw20036_led";
			aw20036,imax = <1>;
			aw20036,brightness = <128>;
			aw20036,max_brightness = <255>;
		};
	};
};

&pinctrl {
	aw20036 {
		aw20036_pins: aw20036-pins {
			rockchip,pins =
				<4 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>,
				<4 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	cam {
		cam_clkout0: cam-clkout0 {
			rockchip,pins =
				/* cam_clkout0 */
				<4 RK_PA7 1 &pcfg_pull_none>;
		};

		cam_sleep: cam-sleep {
			rockchip,pins =
				/* cam_sleep */
				<4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		camera_rst: camera-rst {
			rockchip,pins =
				/* front camera reset */
				<4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>,
				/* back camra reset */
				<4 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		flash_led_gpios: flash-led {
			rockchip,pins =
				/* flash led enable */
				<4 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	tp {
		tp_gpio: tp-gpio {
			rockchip,pins = <3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	audio-amplifier {
		spk_amp_enable_h: spk-amp-enable-h {
			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	headphone {
		hp_det: hp-det {
			rockchip,pins = <4 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	lcd {
		lcd_rst_gpio: lcd-rst-gpio {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd_enable_gpio: lcd-enable-gpio {
			rockchip,pins = <0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

	};

	pmic {
		pmic_int: pmic_int {
			rockchip,pins =
				<0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		soc_slppin_gpio: soc_slppin_gpio {
			rockchip,pins =
				<0 RK_PA2 RK_FUNC_GPIO &pcfg_output_low>;
		};

		soc_slppin_slp: soc_slppin_slp {
			rockchip,pins =
				<0 RK_PA2 1 &pcfg_pull_none>;
		};

		soc_slppin_rst: soc_slppin_rst {
			rockchip,pins =
				<0 RK_PA2 2 &pcfg_pull_none>;
		};
	};

	sensor {
		sensor_gpio: sensor-gpio {
			rockchip,pins = <3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	vcc_sd {
		vcc_sd_h: vcc-sd-h {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <2 RK_PB2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	wireless-bluetooth {
		uart1_gpios: uart1-gpios {
			rockchip,pins = <2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	keys {
		gpio_keys_ctrl: gpio-keys-ctrl {
			rockchip,pins =
				<3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>, <3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>,
				<3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>, <3 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>,
				<3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>, <3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>,
				<3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>, <3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>,
				<3 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>, <3 RK_PD7 RK_FUNC_GPIO &pcfg_pull_none>,
				<4 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>, <4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>,
				<4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>, <4 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>,
				<4 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>, <4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>,
				<4 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>, <2 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	powerCtrl {
		powerCtrl_en: powerCtrl-en {
			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>, <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pmu_io_domains {
	status = "okay";
	pmuio1-supply = <&vcc3v3_pmu>;
	pmuio2-supply = <&vcc_3v3>;
	vccio1-supply = <&vccio_acodec>;
	vccio3-supply = <&vccio_sd>;
	vccio4-supply = <&vcc_3v3>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc_3v3>;
	vccio7-supply = <&vcc_3v3>;
};

&pwm2 {
	status = "okay";
};

&pwm3 {
	status = "okay";
};

&pwm4 {
	status = "okay";
};

&rk_rga {
	status = "okay";
};

&rkisp {
	status = "okay";
};

&rkisp_mmu {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp0_in: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&csidphy0_out>;
		};
	};
};

&rkvdec {
	status = "okay";
};

&rkvdec_mmu {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};

&route_dsi0 {
	status = "okay";
	connect = <&vp0_out_dsi0>;
};

&route_hdmi {
	status = "okay";
	connect = <&vp0_out_hdmi>;
};

&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&sdhci {
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	max-frequency = <200000000>;
	status = "okay";
};

&sdmmc0 {
	max-frequency = <150000000>;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	status = "okay";
};

&sdmmc1 {
    max-frequency = <150000000>;

    no-sd;
    no-mmc;
    no-1-8-v;
    voltage-ranges = <3300 3300>;

    bus-width = <4>;
    cap-sd-highspeed;
    cap-sdio-irq;
    keep-power-in-suspend;
    non-removable;

    mmc-pwrseq = <&sdio_pwrseq>;
    vmmc-supply = <&vcc_3v3>;
    vqmmc-supply = <&vcc_wifi_io>;

    pinctrl-names = "default";
    pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk>;
    sd-uhs-sdr12;
    sd-uhs-sdr25;
    sd-uhs-sdr50;
    sd-uhs-sdr104;

    status = "okay";
};

&sdmmc2 {
	max-frequency = <100000000>;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;

	no-sdio;
	no-mmc;

	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd>;

	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc2m1_bus4 &sdmmc2m1_cmd &sdmmc2m1_clk &sdmmc2m1_det>;

	status = "okay";
};

&tsadc {
	status = "okay";
};

&uart1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn &uart1m0_rtsn>;
	uart-has-rtscts;

	bluetooth {
		compatible = "realtek,rtl8723ds-bt", "realtek,rtl8723bs-bt";
		//device-wake-gpios = <&gpio2 RK_PC4 GPIO_ACTIVE_HIGH>;
		enable-gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		//host-wake-gpios = <&gpio2 RK_PC3 GPIO_ACTIVE_HIGH>;
		max-speed = <1500000>;
	};
};

&u2phy0_otg {
	status = "okay";
	vbus-supply = <&otg_switch>;
	phy-supply = <&otg_switch>;
};

&usb2phy0 {
	status = "okay";
};

&usbdrd_dwc3 {
    dr_mode = "otg";
    extcon = <&usb2phy0>;
    status = "okay";
};

&usbdrd30 {
	status = "okay";
};

&vdpu {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&vepu {
	status = "okay";
};

&vepu_mmu {
	status = "okay";
};

&vop {
	status = "okay";
	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
};

&vop_mmu {
	status = "okay";
};
